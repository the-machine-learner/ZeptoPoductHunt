        <mxCell id="e_hunt_yes" edge="1" parent="1" source="d_is_hunt" target="node_win" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#15803d;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- END NODE AT BOTTOM -->
